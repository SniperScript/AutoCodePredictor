{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AutoCode VS Code Extension (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/playground.cpp"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/out/**/*.js"
      ]
    }
  ]
}
